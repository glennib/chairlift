SetRoleQuery
  Keyword "SET"
  Keyword "ROLE"
  Keyword "DEFAULT"

> SET DEFAULT ROLE NONE TO u, CURRENT_USER
SetRoleQuery
  Keyword "SET"
  Keyword "DEFAULT"
  Keyword "ROLE"
  RoleSet
    RoleList
      RoleKeyword
        Keyword "NONE"
  Keyword "TO"
  RoleSet
    RoleList
      UserName
        Name
          BareWord "u"
      Comma ","
      RoleKeyword
        Keyword "CURRENT_USER"
