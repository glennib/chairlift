    Keyword "SELECT"
  AccessClause
    Keyword "USING"
    AndExpr
      BinaryExpr
        Name
          BareWord "a"
        Equals "="
        Literal
          Number "1"
      Keyword "AND"
      Name
        BareWord "b"
  AccessClause
    Keyword "TO"
    RoleSet
      RoleList
        RoleKeyword
          Keyword "ALL"
      Keyword "EXCEPT"
      RoleList
        UserName
          Name
            BareWord "r"

