        IntervalUnit
          Keyword "MONTH"
        Keyword "TRACKING"
        Keyword "ONLY"
  AccessClause
    Keyword "NOT"
    Keyword "KEYED"

> CREATE ROW POLICY p ON db.t AS RESTRICTIVE FOR SELECT USING a = 1 AND b TO ALL EXCEPT r
