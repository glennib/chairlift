---
source: src/syntax/grammar/access/tests.rs
expression: "trees(&[\"CREATE QUOTA q KEYED BY user_name FOR INTERVAL 1 hour MAX queries = 10, errors = 2, \\\n         FOR RANDOMIZED INTERVAL 2 DAY NO LIMITS TO r\",\n\"ALTER QUOTA IF EXISTS q FOR INTERVAL 1 MONTH TRACKING ONLY NOT KEYED\",\n\"CREATE ROW POLICY p ON db.t AS RESTRICTIVE FOR SELECT USING a = 1 AND b TO ALL EXCEPT r\",\n\"CREATE POLICY p1, p2 ON db.t, db.u USING NONE\",\n\"DROP ROW POLICY IF EXISTS p ON db.t, q ON db.u ON CLUSTER c\",\n\"CREATE SETTINGS PROFILE p SETTINGS max_threads = 1 READONLY INHERIT 'default' TO r\",\n\"ALTER PROFILE p ADD SETTING a = 1\", \"DROP SETTINGS PROFILE IF EXISTS p, 'q'\",\n\"DROP QUOTA q\",])"
---
> CREATE QUOTA q KEYED BY user_name FOR INTERVAL 1 hour MAX queries = 10, errors = 2, FOR RANDOMIZED INTERVAL 2 DAY NO LIMITS TO r
AccessEntityQuery
  Keyword "CREATE"
  Keyword "QUOTA"
  NameList
    Name
      BareWord "q"
  AccessClause
    Keyword "KEYED"
    Keyword "BY"
    NameList
      Name
        BareWord "user_name"
  AccessClause
    QuotaIntervalList
      QuotaInterval
        Keyword "FOR"
        Keyword "INTERVAL"
        Literal
          Number "1"
        IntervalUnit
          Keyword "hour"
        QuotaLimitList
          QuotaLimit
            Keyword "MAX"
            BareWord "queries"
            Equals "="
            Literal
              Number "10"
          Comma ","
          QuotaLimit
            BareWord "errors"
            Equals "="
            Literal
              Number "2"
      Comma ","
      QuotaInterval
        Keyword "FOR"
        Keyword "RANDOMIZED"
        Keyword "INTERVAL"
        Literal
          Number "2"
        IntervalUnit
          Keyword "DAY"
        Keyword "NO"
        Keyword "LIMITS"
  AccessClause
    Keyword "TO"
    RoleSet
      RoleList
        UserName
          Name
            BareWord "r"

