---
source: src/syntax/grammar/show/tests.rs
expression: "trees(&[\"SHOW CREATE TABLE db.t FORMAT TSVRaw\",\n\"show create temporary table t\", \"SHOW CREATE t\", \"SHOW CREATE USER u\",\n\"SHOW TABLES FROM system LIKE '%a%' LIMIT 2\",\n\"SHOW FULL TEMPORARY TABLES IN db NOT ILIKE 'x'\", \"SHOW DATABASES\",\n\"SHOW EXTENDED COLUMNS FROM t FROM db\",\n\"SHOW INDEX FROM t WHERE key_name = 'x'\", \"SHOW SETTING max_threads\",\n\"SHOW CHANGED SETTINGS LIKE 'max%'\",\n\"SHOW GRANTS FOR u, CURRENT_USER WITH IMPLICIT FINAL\",\n\"SHOW PROCESSLIST INTO OUTFILE 'x'\",])"
---
> SHOW CREATE TABLE db.t FORMAT TSVRaw
ShowQuery
  Keyword "SHOW"
  Keyword "CREATE"
  Keyword "TABLE"
  QualifiedName
    Name
      BareWord "db"
    Dot "."
    Name
      BareWord "t"
  FormatClause
    Keyword "FORMAT"
    Name
      BareWord "TSVRaw"

> show create temporary table t
