> ATTACH TABLE t (a UInt8) ENGINE = Memory
AttachQuery
  Keyword "ATTACH"
  Keyword "TABLE"
  Name
    BareWord "t"
  Opaque
    OpeningRoundBracket "("
    BareWord "a"
    BareWord "UInt8"
    ClosingRoundBracket ")"
    BareWord "ENGINE"
    Equals "="
    BareWord "Memory"

