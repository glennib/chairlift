---
> ATTACH TABLE IF NOT EXISTS db.t ON CLUSTER c
AttachQuery
  Keyword "ATTACH"
  Keyword "TABLE"
  IfNotExists
    Keyword "IF"
    Keyword "NOT"
    Keyword "EXISTS"
  QualifiedName
    Name
      BareWord "db"
    Dot "."
    Name
      BareWord "t"
  OnCluster
    Keyword "ON"
    Keyword "CLUSTER"
    Name
      BareWord "c"

> ATTACH TABLE t UUID '00000000-0000-0000-0000-000000000001' AS NOT REPLICATED
AttachQuery
  Keyword "ATTACH"
  Keyword "TABLE"
  Name
    BareWord "t"
  TableUuid
    Keyword "UUID"
    Literal
      StringLiteral "'00000000-0000-0000-0000-000000000001'"
  Keyword "AS"
  Keyword "NOT"
  Keyword "REPLICATED"

