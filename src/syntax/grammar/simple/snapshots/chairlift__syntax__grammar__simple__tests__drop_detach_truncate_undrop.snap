---
source: src/syntax/grammar/simple/tests.rs
expression: "trees(&[\"DROP TABLE IF EXISTS db.a, b ON CLUSTER '{cluster}' SYNC\",\n\"drop temporary table if empty t no delay\", \"DROP VIEW v\",\n\"DROP DICTIONARY IF EXISTS {{ db }}.d\",\n\"DROP DATABASE IF EXISTS {db:Identifier} ON CLUSTER c\",\n\"DROP FUNCTION IF EXISTS f ON CLUSTER c\",\n\"DROP NAMED COLLECTION IF EXISTS nc\", \"DROP INDEX IF EXISTS i ON db.t\",\n\"DROP WORKLOAD w\", \"DROP HANDLER IF EXISTS h\",\n\"DETACH TABLE t ON CLUSTER c PERMANENTLY SYNC\", \"DETACH DATABASE d\",\n\"TRUNCATE t\", \"TRUNCATE TABLE IF EXISTS db.t ON CLUSTER c\",\n\"TRUNCATE ALL TABLES FROM IF EXISTS db NOT LIKE 'tmp%'\",\n\"UNDROP TABLE db.t UUID '00000000-0000-0000-0000-000000000001' ON CLUSTER c\",\n\"DROP TABLE t FORMAT Null SETTINGS max_execution_time = 1\",])"
---
> DROP TABLE IF EXISTS db.a, b ON CLUSTER '{cluster}' SYNC
DropQuery
  Keyword "DROP"
  Keyword "TABLE"
  IfExists
    Keyword "IF"
    Keyword "EXISTS"
  NameList
    QualifiedName
      Name
        BareWord "db"
      Dot "."
      Name
        BareWord "a"
    Comma ","
    Name
      BareWord "b"
  OnCluster
    Keyword "ON"
    Keyword "CLUSTER"
    Literal
      StringLiteral "'{cluster}'"
  Keyword "SYNC"

