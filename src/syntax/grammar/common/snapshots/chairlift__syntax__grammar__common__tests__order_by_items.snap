---
source: src/syntax/grammar/common/tests.rs
expression: "trees(&[\"a, b DESC\", \"x ASC NULLS FIRST, y COLLATE 'en'\",\n\"d WITH FILL FROM 1 TO 10 STEP 1\",\n\"t WITH FILL STEP INTERVAL 1 DAY STALENESS 2\", \"a AS b DESC\",\n\"f(x) desc, g(y y), z\",], order_by)"
---
> a, b DESC
OrderByList
  OrderByItem
    Name
      BareWord "a"
  Comma ","
  OrderByItem
    Name
      BareWord "b"
    Keyword "DESC"

> x ASC NULLS FIRST, y COLLATE 'en'
OrderByList
  OrderByItem
    Name
      BareWord "x"
    Keyword "ASC"
    Keyword "NULLS"
    Keyword "FIRST"
  Comma ","
  OrderByItem
    Name
      BareWord "y"
    Keyword "COLLATE"
    Literal
      StringLiteral "'en'"

> d WITH FILL FROM 1 TO 10 STEP 1
OrderByList
  OrderByItem
    Name
      BareWord "d"
    Keyword "WITH"
    Keyword "FILL"
    Keyword "FROM"
    Literal
      Number "1"
    Keyword "TO"
    Literal
      Number "10"
    Keyword "STEP"
    Literal
      Number "1"

> t WITH FILL STEP INTERVAL 1 DAY STALENESS 2
OrderByList
  OrderByItem
    Name
      BareWord "t"
    Keyword "WITH"
    Keyword "FILL"
    Keyword "STEP"
    IntervalExpr
      Keyword "INTERVAL"
      Literal
        Number "1"
      IntervalUnit
        Keyword "DAY"
    Keyword "STALENESS"
    Literal
      Number "2"

> a AS b DESC
OrderByList
  OrderByItem
    AliasedExpr
      Name
        BareWord "a"
      Alias
        Keyword "AS"
        Name
          BareWord "b"
    Keyword "DESC"

> f(x) desc, g(y y), z
OrderByList
  OrderByItem
    FunctionCall
      Name
        BareWord "f"
      ArgList
        OpeningRoundBracket "("
        Name
          BareWord "x"
        ClosingRoundBracket ")"
    Keyword "desc"
  Comma ","
  OrderByItem
    FunctionCall
      Name
        BareWord "g"
      ArgList
        OpeningRoundBracket "("
        VerbatimItem
          BareWord "y"
          BareWord "y"
        ClosingRoundBracket ")"
  Comma ","
  OrderByItem
    Name
      BareWord "z"
