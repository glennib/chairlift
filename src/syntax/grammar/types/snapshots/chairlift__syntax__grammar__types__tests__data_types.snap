> Enum8('a' = 1, 'b' = -2)
DataType
  Name
    BareWord "Enum8"
  TypeArgList
    OpeningRoundBracket "("
    BinaryExpr
      Literal
        StringLiteral "'a'"
      Equals "="
      Literal
        Number "1"
    Comma ","
    BinaryExpr
      Literal
        StringLiteral "'b'"
      Equals "="
      PrefixExpr
        Minus "-"
        Literal
          Number "2"
    ClosingRoundBracket ")"

