> JSON(max_dynamic_paths = 10, a.b UInt32, SKIP a.c, SKIP REGEXP 'x.*')
DataType
  Name
    BareWord "JSON"
  TypeArgList
    OpeningRoundBracket "("
    BinaryExpr
      Name
        BareWord "max_dynamic_paths"
      Equals "="
      Literal
        Number "10"
    Comma ","
    NameTypePair
      QualifiedName
        Name
          BareWord "a"
        Dot "."
        Name
          BareWord "b"
      DataType
        Name
          BareWord "UInt32"
    Comma ","
    JsonSkip
      Keyword "SKIP"
      QualifiedName
        Name
          BareWord "a"
        Dot "."
        Name
          BareWord "c"
    Comma ","
    JsonSkip
      Keyword "SKIP"
      Keyword "REGEXP"
      Literal
        StringLiteral "'x.*'"
    ClosingRoundBracket ")"

